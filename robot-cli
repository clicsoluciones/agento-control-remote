        client_uuid = str(uuid.uuid4())
        print(f"   {YELLOW}UUID generado:{RESET} {client_uuid}")
    else:
        print(f"   {GREEN}✔ UUID detectado:{RESET} {client_uuid}")

    # 4. Generate random password
    print(f"{CYAN}3. Generando contraseña segura aleatoria...{RESET}")
    password = secrets.token_urlsafe(16)

    # 5. Save to local SQLite database
    print(f"{CYAN}4. Guardando credenciales en base de datos local (data/devices.db)...{RESET}")
    create_or_update_device(name=name, device_id=mac, client_id=client_uuid, password=password)

