def resolve_esptool() -> list:
    """Find the best esptool executable or module call."""
    local_esptool = os.path.join(WORKSPACE, ".venv", "bin", "esptool")
    if os.path.exists(local_esptool):
        return [local_esptool]
    fallback_esptool = "/home/yaqui/App-dev/agents/agent1/venv/bin/esptool.py"
    if os.path.exists(fallback_esptool):
        return [fallback_esptool]
    which_esptool = shutil.which("esptool") or shutil.which("esptool.py")
    if which_esptool:
        return [which_esptool]
    return [sys.executable, "-m", "esptool"]


def detect_serial_port() -> str:
    """Detect available serial port across Windows, macOS, and Linux."""
    if os.getenv("ROBOT_PORT"):
        return os.getenv("ROBOT_PORT")

    # Try pyserial list_ports
    try:
        import serial.tools.list_ports
        ports = list(serial.tools.list_ports.comports())
        if ports:
            for p in ports:
                desc = f"{p.description or ''} {p.manufacturer or ''}".lower()
                if any(k in desc for k in ["esp32", "ch340", "cp210", "usb", "acm", "uart", "serial"]):
                    return p.device
            return ports[0].device
    except Exception:
        pass

    if sys.platform.startswith("win"):
        return "COM3"
    elif sys.platform.startswith("darwin"):
        import glob
        matches = glob.glob("/dev/cu.usbmodem*") + glob.glob("/dev/cu.usbserial*")
        return matches[0] if matches else "/dev/cu.usbmodem01"
    else:
        import glob
        matches = glob.glob("/dev/ttyACM*") + glob.glob("/dev/ttyUSB*")
        return matches[0] if matches else "/dev/ttyACM0"


def check_port_exists(port_name: str) -> bool:
    """Check if the given serial port exists or is connected."""
    if sys.platform.startswith("win"):
        try:
            import serial.tools.list_ports
            return any(p.device.upper() == port_name.upper() for p in serial.tools.list_ports.comports())
        except Exception:
            return True
    return os.path.exists(port_name)


