def resolve_esptool() -> list:
    """Find the best esptool executable or module call."""
    local_esptool = os.path.join(WORKSPACE, ".venv", "bin", "esptool")
    if os.path.exists(local_esptool):
        return [local_esptool]
    fallback_esptool = "/home/yaqui/App-dev/agents/agent1/venv/bin/esptool.py"
    if os.path.exists(fallback_esptool):
        return [fallback_esptool]
    which_esptool = shutil.which("esptool") or shutil.which("esptool.py")
    if which_esptool:
        return [which_esptool]
    return [sys.executable, "-m", "esptool"]


