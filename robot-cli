            env_file = os.path.join(WORKSPACE, ".env")
            try:
                with open(env_file, "a") as f:
                    f.write(f"\nROBOT_PROD_URL={prod_url}\n")
                print(f"{GREEN}✔ Guardado en .env local (ROBOT_PROD_URL){RESET}")
            except Exception:
                pass
        except (KeyboardInterrupt, EOFError):
            print("\nOperación cancelada.")
            return

    if is_prod and prod_url:
        print(f"{CYAN}5. Registrando en API de Producción ({prod_url})...{RESET}")
        try:
            reg_endpoint = prod_url.rstrip("/") + "/api/devices/register"
            res = api_request(reg_endpoint, method="POST", payload={
                "name": name,
                "device_id": mac,
                "client_id": client_uuid,
                "password": password
            })
            if res.get("status") == "ok":
                print(f"   {GREEN}✔ Cuenta registrada exitosamente en el servidor de producción vía API REST.{RESET}")
            else:
                print(f"   {YELLOW}[ADVERTENCIA] Respuesta de la API: {res}{RESET}")
        except Exception as e:
            print(f"   {YELLOW}[ADVERTENCIA] Error registrando vía API del servidor: {e}{RESET}")

    lan_ip = get_local_lan_ip()
    access_url = f"https://{lan_ip}:8443/"
    if is_prod and prod_url:
        import urllib.parse
        parsed = urllib.parse.urlparse(prod_url)
        if parsed.scheme == "https" and not parsed.port:
            access_url = f"https://{parsed.hostname}/"
        elif parsed.port:
            access_url = f"{parsed.scheme}://{parsed.hostname}:{parsed.port}/"
        else:
            access_url = f"{parsed.scheme}://{parsed.hostname}/"
    elif is_prod:
        access_url = "https://agento.yaquimartinez.com/"

    # 7. Save credentials to a persistent text file
    creds_dir = os.path.join(WORKSPACE, "credentials")
    os.makedirs(creds_dir, exist_ok=True)
    creds_file = os.path.join(creds_dir, f"credentials_{clean_name}.txt")

    env_title = "PRODUCCIÓN (API Remota)" if is_prod else "LOCAL"
    file_content = f"""=================================================================
AGENTO CONTROL REMOTE - CREDENCIALES DEL DISPOSITIVO
=================================================================
Fecha de Registro:       {time.strftime('%Y-%m-%d %H:%M:%S')}
Entorno:                 {env_title}
URL de Acceso Web (PWA): {access_url}

Nombre del Dispositivo:  {name}
Contraseña de Acceso:    {password}

Device-Id (MAC):         {mac}
Client-Id (UUID):        {client_uuid}
=================================================================
INSTRUCCIONES DE ACCESO:
1. Abrí en tu celular o navegador web:
   {access_url}
2. Iniciá sesión con:
   • Dispositivo: {name}
   • Contraseña:  {password}
=================================================================
"""
    with open(creds_file, "w", encoding="utf-8") as f:
        f.write(file_content)

    # 8. Print clean formatted credential card to terminal
    print(f"\n{BOLD}{GREEN}================================================================={RESET}")
    print(f"{BOLD}{GREEN}  ✔ CUENTA DE DISPOSITIVO REGISTRADA CON ÉXITO [{env_title}]{RESET}")
    print(f"{BOLD}{GREEN}================================================================={RESET}")
    print(f"  {BOLD}Nombre del Dispositivo:{RESET}  {CYAN}{name}{RESET}")
    print(f"  {BOLD}Device-Id (MAC):{RESET}         {mac}")
    print(f"  {BOLD}Client-Id (UUID):{RESET}        {client_uuid}")
    print(f"  {BOLD}Contraseña de Acceso:{RESET}    {YELLOW}{password}{RESET}")
    print(f"-----------------------------------------------------------------")
    print(f"  {BOLD}📁 Archivo de Credenciales:{RESET}")
    print(f"     {GREEN}{creds_file}{RESET}")
    print(f"     {YELLOW}(Tus credenciales y contraseña se guardaron en este archivo){RESET}")
    print(f"-----------------------------------------------------------------")
    print(f"  {BOLD}URL de Acceso Web (PWA):{RESET} {access_url}")
    print(f"  {BOLD}Credenciales para Login:{RESET}")
    print(f"    • Dispositivo: {CYAN}{name}{RESET}")
    print(f"    • Contraseña:  {YELLOW}{password}{RESET}")
    print(f"{BOLD}{GREEN}================================================================={RESET}\n")
    print(f"{BOLD}{GREEN}================================================================={RESET}\n")


def cmd_account_list(args):
    is_prod = getattr(args, "prod", False) or bool(getattr(args, "url", None))
    prod_url = getattr(args, "url", None) or get_env_var("ROBOT_PROD_URL")

    if is_prod:
        if not prod_url:
            try:
                prod_url = input(f"{BOLD}URL del servidor de Producción (ej: http://MI-VPS:8088): {RESET}").strip()
            except (KeyboardInterrupt, EOFError):
                return
        if not prod_url:
            print(f"{RED}[ERROR] URL de producción requerida.{RESET}")
            return

        print(f"\n{BOLD}{CYAN}=== DISPOSITIVOS EN PRODUCCIÓN ({prod_url}) ==={RESET}\n")
        try:
            list_endpoint = prod_url.rstrip("/") + "/api/devices"
            res = api_request(list_endpoint, method="GET")
            devices = res.get("devices", [])
        except Exception as e:
            print(f"{RED}[ERROR] Error consultando la API de producción: {e}{RESET}")
            return
    else:
        if WORKSPACE not in sys.path:
            sys.path.insert(0, WORKSPACE)
        from app.db import list_devices
        devices = list_devices()
        print(f"\n{BOLD}{CYAN}=== DISPOSITIVOS REGISTRADOS EN SQLite LOCAL (data/devices.db) ==={RESET}\n")

    if not devices:
        print(f"  {YELLOW}No hay dispositivos registrados aún. Ejecute './robot-cli account create'{RESET}\n")
        return

    header = f"{'ID':<4} {'Nombre':<15} {'Device-Id (MAC)':<20} {'Client-Id (UUID)':<38} {'Creado'}"
    print(f"{BOLD}{header}{RESET}")
    print("-" * len(header))
    for d in devices:
        print(f"{d['id']:<4} {d['name']:<15} {d['device_id']:<20} {d['client_id']:<38} {d['created_at']}")
    print()


def main():
    parser = argparse.ArgumentParser(description="Robot CLI - Standalone Controller for agento-control-remote")
    parser.add_argument("-p", "--port", dest="global_port", help="Serial port of robot (e.g. COM3, /dev/ttyACM0, /dev/cu.usbmodem*)")

    port_parser = argparse.ArgumentParser(add_help=False)
    port_parser.add_argument("-p", "--port", help="Serial port of robot (e.g. COM3 on Windows, /dev/ttyACM0 on Linux, /dev/cu.usbmodem* on macOS)")

    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("status", parents=[port_parser], help="Show hardware, NVS endpoints, and gateway Docker status")

    p_route = subparsers.add_parser("route", parents=[port_parser], help="Switch robot endpoint (local | prod | native | custom)")
    p_route.add_argument("target", choices=["local", "prod", "production", "native", "custom"], help="Target destination")
    p_route.add_argument("--url", dest="custom_url", help="Custom server URL (defaults to http://<lan_ip>:8080)")

    subparsers.add_parser("monitor", parents=[port_parser], help="Open real-time serial monitor of the robot")

    p_backup = subparsers.add_parser("backup", parents=[port_parser], help="Create binary backup of flash or NVS")
    p_backup.add_argument("--type", choices=["nvs", "full"], default="nvs", help="Backup type (default: nvs)")

    p_restore = subparsers.add_parser("restore", parents=[port_parser], help="Restore factory or custom firmware")
    p_restore.add_argument("--file", help="Custom firmware .bin file to restore (defaults to factory)")

    p_account = subparsers.add_parser("account", help="Manage multi-device robot accounts in SQLite")
    acc_sub = p_account.add_subparsers(dest="account_cmd", required=True)

    p_acc_create = acc_sub.add_parser("create", parents=[port_parser], help="Create a device account from connected hardware")
    p_acc_create.add_argument("--name", help="Device name (e.g. robot-1)")
    p_acc_create.add_argument("--prod", action="store_true", help="Register directly to production server via REST API")
    p_acc_create.add_argument("--url", help="Custom production server URL (e.g. https://agento.yaquimartinez.com)")

    p_acc_list = acc_sub.add_parser("list", help="List registered device accounts")
    p_acc_list.add_argument("--prod", action="store_true", help="List devices registered on production server via REST API")
    p_acc_list.add_argument("--url", help="Custom production server URL (e.g. https://agento.yaquimartinez.com)")

    args = parser.parse_args()

    global PORT
    selected_port = getattr(args, "port", None) or getattr(args, "global_port", None)
    if selected_port:
        PORT = selected_port

    if args.command == "status":
        cmd_status(args)
    elif args.command == "route":
        cmd_route(args)
    elif args.command == "monitor":
        cmd_monitor(args)
    elif args.command == "backup":
        cmd_backup(args)
    elif args.command == "restore":
        cmd_restore(args)
    elif args.command == "account":
        if args.account_cmd == "create":
            cmd_account_create(args)
        elif args.account_cmd == "list":
            cmd_account_list(args)


if __name__ == "__main__":
    main()
