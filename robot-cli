def get_env_var(var_name: str, default=None):
    val = os.getenv(var_name)
    if val:
        return val
    env_file = os.path.join(WORKSPACE, ".env")
    if os.path.exists(env_file):
        try:
            with open(env_file, "r") as f:
                for line in f:
                    line = line.strip()
                    if line.startswith(f"{var_name}="):
                        return line.split("=", 1)[1].strip().strip('"').strip("'")
        except Exception:
            pass
    return default


def cmd_route(args):
    target = args.target.lower()
    lan_ip = get_local_lan_ip()

    if target == "custom":
        url = args.custom_url or f"http://{lan_ip}:8080"
        ota_target = url.rstrip("/") + "/xiaozhi/ota/"
        ws_target = url.replace("http://", "ws://").replace("https://", "wss://").rstrip("/") + "/xiaozhi/v1/"
        desc = f"Custom Gateway ({url})"
    elif target == "native":
        ota_target = "https://api.tenclass.net/xiaozhi/ota/"
        ws_target = "wss://api.tenclass.net/xiaozhi/v1/"
        desc = "Native Factory Cloud (Bitsy / TenClass)"
    elif target == "local":
        url = args.custom_url or f"http://{lan_ip}:8080"
        ota_target = url.rstrip("/") + "/xiaozhi/ota/"
        ws_target = url.replace("http://", "ws://").replace("https://", "wss://").rstrip("/") + "/xiaozhi/v1/"
        desc = f"Modo Local ({url})"
    elif target in ("prod", "production"):
        prod_url = args.custom_url or get_env_var("ROBOT_PROD_URL")
        if not prod_url:
            print(f"{YELLOW}No se especificó la URL de Producción.{RESET}")
            try:
                prod_url = input(f"{BOLD}Ingrese la URL o IP del servidor de Producción (ej: http://MI_VPS_IP:8088): {RESET}").strip()
            except (KeyboardInterrupt, EOFError):
                print("\nOperación cancelada.")
                return
            if prod_url:
                env_file = os.path.join(WORKSPACE, ".env")
                try:
                    with open(env_file, "a") as f:
                        f.write(f"\nROBOT_PROD_URL={prod_url}\n")
                    print(f"{GREEN}✔ Guardado en .env local (ROBOT_PROD_URL){RESET}")
                except Exception:
                    pass
        if not prod_url:
            print(f"{RED}[ERROR] URL de producción requerida.{RESET}")
            return
        ota_target = prod_url.rstrip("/") + "/xiaozhi/ota/"
        ws_target = prod_url.replace("http://", "ws://").replace("https://", "wss://").rstrip("/") + "/xiaozhi/v1/"
        desc = "Modo Producción (Servidor VPS Remoto)"
    else:
        print(f"{RED}[ERROR] Unknown target: {target}{RESET}")
        return

    print(f"\n{BOLD}{CYAN}=== SWITCHING ROBOT ROUTE TO: {desc} ==={RESET}\n")
    print(f"  Target OTA: {BOLD}{ota_target}{RESET}")
    print(f"  Target WS:  {BOLD}{ws_target}{RESET}")

    print(f"\n1. Reading current NVS from device...")
    nvs_buf = read_device_nvs()
    if not nvs_buf:
        return

    ts = int(time.time())
    backup_path = os.path.join(NVS_BACKUPS_DIR, f"nvs_backup_before_route_{ts}.bin")
    with open(backup_path, "wb") as f:
        f.write(nvs_buf)
    print(f"2. Current NVS backed up to: {backup_path}")

    print("3. Patching NVS parameters...")
    patched = patch_or_add_nvs_string(nvs_buf, 3, "ota_url", ota_target)
    patched = patch_or_add_nvs_string(patched, 7, "url", ws_target)

    print("4. Writing patched NVS to 0x9000 (16KB) & resetting robot...")
    if write_device_nvs(patched):
        print(f"\n{GREEN}{BOLD}✔ SUCCESS! Robot routed to {desc} and restarted!{RESET}\n")
    else:
        print(f"\n{RED}{BOLD}✖ FAILED to flash NVS.{RESET}\n")


def cmd_monitor(args):
    import serial
    print(f"\n{BOLD}{CYAN}=== ESP32 SERIAL MONITOR ({PORT} @ {SERIAL_BAUD}) ==={RESET}")
    print(f"{YELLOW}Press Ctrl+C to exit monitor.{RESET}\n")
    try:
        ser = serial.Serial(PORT, SERIAL_BAUD, timeout=0.1)
    except Exception as e:
        print(f"{RED}[ERROR] Could not open {PORT}: {e}{RESET}")
        return

    try:
        while True:
            line = ser.readline()
            if line:
                decoded = line.decode('utf-8', errors='replace').rstrip()
                if "E (" in decoded:
                    print(f"{RED}{decoded}{RESET}")
                elif "W (" in decoded:
                    print(f"{YELLOW}{decoded}{RESET}")
                elif "I (" in decoded:
                    print(f"{CYAN}{decoded}{RESET}")
                else:
                    print(decoded)
    except KeyboardInterrupt:
        print(f"\n{GREEN}Monitor stopped.{RESET}")
    finally:
        ser.close()


def cmd_backup(args):
    import hashlib
    ts = int(time.time())
    if args.type == "nvs":
        out_file = os.path.join(NVS_BACKUPS_DIR, f"nvs_backup_{ts}.bin")
        cmd = ESPTOOL_CMD + ["-p", PORT, "-b", str(BAUD), "read_flash", NVS_OFFSET, NVS_SIZE, out_file]
    else:
        out_file = os.path.join(NVS_BACKUPS_DIR, f"flash_full_16MB_{ts}.bin")
        cmd = ESPTOOL_CMD + ["-p", PORT, "-b", str(BAUD), "read_flash", "0", "0x1000000", out_file]

    print(f"{CYAN}Starting {args.type.upper()} backup...{RESET}")
    res = subprocess.run(cmd)
    if res.returncode == 0 and os.path.exists(out_file):
        sha = hashlib.sha256(open(out_file, "rb").read()).hexdigest()
        print(f"\n{GREEN}✔ Backup saved:{RESET} {out_file}")
        print(f"  SHA-256: {sha}\n")
    else:
        print(f"{RED}✖ Backup failed.{RESET}")


def cmd_restore(args):
    target = BACKUP_FACTORY
    if args.file:
        target = args.file

    if not os.path.exists(target):
        print(f"{RED}[ERROR] Backup file not found: {target}{RESET}")
        return

    print(f"\n{RED}{BOLD}⚠ CAUTION: FLASHING FIRMWARE TO DEVICE ⚠{RESET}")
    print(f"Target file: {target} ({os.path.getsize(target)} bytes)")
    confirm = input("Are you sure you want to write to flash 0x0? (yes/no): ")
    if confirm.lower() != "yes":
        print("Restoration aborted.")
        return

    cmd = ESPTOOL_CMD + ["-p", PORT, "-b", str(BAUD), "write_flash", "0", target]
    subprocess.run(cmd)
    subprocess.run(ESPTOOL_CMD + ["-p", PORT, "run"])
    print(f"\n{GREEN}✔ Firmware restored and chip restarted!{RESET}")


def read_device_mac():
    """Read the MAC address directly from the connected ESP32 chip using esptool."""
    cmd = ESPTOOL_CMD + ["-p", PORT, "read-mac"]
    try:
        res = subprocess.run(cmd, capture_output=True, text=True)
        if res.returncode == 0:
            import re
            m = re.findall(r"MAC:\s+([0-9a-fA-F:]{17})", res.stdout)
            if m:
                return m[0].lower()
    except Exception as e:
        print(f"{YELLOW}[WARN] Could not read MAC via esptool: {e}{RESET}")
    return None


def read_device_uuid():
    """Extract Client-Id UUID from NVS if available, else None."""
    try:
        buf = read_device_nvs()
        if buf:
            import re
            m = re.findall(r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}', buf.decode('latin1', errors='ignore'))
            if m:
                return m[0]
    except Exception:
        pass
    return None


def api_request(url: str, method: str = "GET", payload: dict = None):
    import urllib.request
    import json
    import ssl

    data = json.dumps(payload).encode("utf-8") if payload else None
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    headers = {"Content-Type": "application/json"} if payload else {}
    req = urllib.request.Request(url, data=data, headers=headers)
    req.method = method
    with urllib.request.urlopen(req, context=ctx, timeout=10) as resp:
        return json.loads(resp.read().decode("utf-8"))


def cmd_account_create(args):
    import secrets
    import uuid
    import time
    import re
    if WORKSPACE not in sys.path:
        sys.path.insert(0, WORKSPACE)
    from app.db import create_or_update_device

    print(f"\n{BOLD}{CYAN}=== REGISTRO DE CUENTA DE DISPOSITIVO (agento-control-remote) ==={RESET}\n")

    # 1. Ask for device name
    name = getattr(args, "name", None)
    if not name:
        try:
            name = input(f"{BOLD}¿Cómo querés llamar a tu robot? (ej: mi-robot-1): {RESET}").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nOperación cancelada.")
            return

    if not name:
        print(f"{RED}[ERROR] El nombre del dispositivo es obligatorio.{RESET}")
        return

    clean_name = re.sub(r'[^a-zA-Z0-9_\-]', '_', name)

    # 2. Compute device_id (MAC) from hardware
    print(f"{CYAN}1. Detectando dirección MAC desde {PORT}...{RESET}")
    mac = read_device_mac()
    if not mac:
        print(f"{YELLOW}[ADVERTENCIA] No se pudo leer MAC desde {PORT}. Usando identificador por defecto.{RESET}")
        mac = "7c:0c:5f:54:cc:b8"
    else:
